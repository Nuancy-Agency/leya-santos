---
import { contact } from "../data/contact";

const links = [
  { href: "#sobre", label: "Sobre" },
  { href: "#especialidades", label: "Especialidades" },
  { href: "#servicos", label: "Serviços" },
  { href: "#galeria", label: "Galeria" },
  { href: "#depoimentos", label: "Depoimentos" },
  { href: "#contato", label: "Contato" },
];
---

<header
  x-data="{ open: false }"
  x-on:keydown.escape.window="open = false"
  class="sticky top-0 z-50 border-b border-ink/10 bg-cream/90 backdrop-blur"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
    <a
      href="#topo"
      class="font-display text-xl font-semibold tracking-tight text-ink"
      translate="no"
    >
      Leya Santos
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Navegação principal">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-ink/80 transition-colors hover:text-terracotta"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={contact.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-cream transition-colors hover:bg-terracotta md:inline-block"
      >
        Agendar no WhatsApp
      </a>

      <button
        type="button"
        x-on:click="open = !open"
        data-js-toggle
        :aria-expanded="open"
        aria-controls="menu-mobile"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full text-ink md:hidden"
      >
        <span class="sr-only">Abrir menu</span>
        <svg x-show="!open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
        </svg>
        <svg x-show="open" x-cloak xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="menu-mobile"
    x-show="open"
    x-cloak
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    class="border-t border-ink/10 bg-cream px-5 pb-6 md:hidden"
    aria-label="Navegação móvel"
  >
    <ul class="flex flex-col gap-1 pt-4">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              x-on:click="open = false"
              class="block rounded-lg px-3 py-3 text-base font-medium text-ink hover:bg-cream-soft"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="pt-2">
        <a
          href={contact.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="block rounded-full bg-ink px-5 py-3 text-center text-base font-semibold text-cream"
        >
          Agendar no WhatsApp
        </a>
      </li>
    </ul>
  </nav>
</header>
