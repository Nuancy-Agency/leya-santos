---
import { especialidades } from "../data/contact";
---

<section id="especialidades" class="scroll-mt-20 py-16 md:py-20">
  <div class="mx-auto max-w-6xl px-5">
    <div data-reveal class="mx-auto max-w-2xl text-center">
      <p class="mb-3 text-sm font-semibold tracking-widest text-terracotta uppercase">Especialidades</p>
      <h2 class="font-display text-3xl font-semibold text-ink sm:text-4xl">
        Técnica para cada tipo de transformação
      </h2>
    </div>

    <ul data-reveal class="mt-10 flex flex-wrap justify-center gap-3" aria-label="Lista de especialidades">
      {
        especialidades.map((item) => (
          <li>
            <span class="inline-block rounded-full border border-copper/30 bg-copper/10 px-4 py-2 text-sm font-medium text-terracotta">
              {item}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
